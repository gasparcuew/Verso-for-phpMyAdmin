{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Verso",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Verso for phpMyAdmin",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "toggle-dark": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "__MSG_toggleDarkDesc__"
    }
  }
}